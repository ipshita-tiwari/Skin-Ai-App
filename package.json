{
  "name": "skin-ai-app",
  "private": true,
  "scripts": {
    "start": "npx concurrently -n backend,frontend -c blue,green \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "py -m uvicorn backend.main:app --reload --host 127.0.0.1 --port 8000",
    "start:frontend": "npm run dev --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
